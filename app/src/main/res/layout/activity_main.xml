<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="游戏局域网服务器"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1B5E20" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="选择一款游戏，同一 WiFi 下的设备扫码或输入 IP:端口即可联机"
            android:textSize="13sp"
            android:textColor="#666666" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="○ 服务器启动中…"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#E65100" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="游戏列表"
            android:textSize="14sp"
            android:textColor="#333333"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/llGames"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="选择上方一款游戏查看地址"
            android:textSize="18sp"
            android:textColor="#1B5E20"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <ImageView
            android:id="@+id/ivQr"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:background="#FFFFFF"
            android:padding="8dp"
            android:contentDescription="局域网访问二维码" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnOpen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="本机打开游戏"
                android:textSize="15sp"
                android:backgroundTint="#1B5E20" />

            <Button
                android:id="@+id/btnCopy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="复制地址"
                android:textSize="15sp"
                android:backgroundTint="#2E7D32" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="玩法提示：\n1. 打开本 App 即自动成为服务器\n2. 选择一款游戏，其他玩家用浏览器/扫码打开下方地址\n3. 一人创建房间，其余输入房间码加入\n4. 手机端请横屏全屏游玩"
            android:textSize="13sp"
            android:textColor="#555555"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>
</ScrollView>
